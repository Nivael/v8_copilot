  "findings": [
    {
      "code": "002547",
      "announcement_id": "1225679976",
      "pages": [
        1,
        2
      ],
      "answer": "春兴拟购董责险：赔偿限额不超过5000万元、年保费不超过30万元、期限12个月；全体董事回避，直接提交股东会审议。",
      "boundary": "赔偿限额不是已赔款或公司现金，拟投保不是合同已经签署、保费已付或保险已生效；最终以合同为准。委员会也全体回避，不能把审议过该议题写成董事会表决通过。"
    },
    {
      "code": "002547",
      "announcement_id": "1225679973",
      "pages": [
        1,
        2
      ],
      "answer": "春兴通知12月7日14时召开临时股东会，审议拟售资产与董责险，股权登记日12月1日；这是待审安排，不是结果公告。",
      "boundary": "第2页概称上述议案已由董事会审议通过，与同日董责险专项公告及董事会决议明确全体回避、直接上股东会的表述不同。差异保留，不据通知认定董责险已经董事会表决通过，也不把未来股东会当资产成交或保险生效。"
    },
    {
      "code": "600337",
      "announcement_id": "1225679385",
      "pages": [
        1,
        4,
        5
      ],
      "answer": "美克会议资料拟于11月25日补选胡辉为非独立董事；孟佳聪辞职要等新任董事补选产生才生效，生效前继续履职。",
      "boundary": "股东会会议资料在20日目录公开，封面及议案落款为未来会议日25日，不证明会议已开或人事已完成。12.29%股东赣州发展美家继续行使提名权；简历另称候选人与控股股东、实际控制人及5%以上股东等无关联关系，两项披露分列，未独立核关联认定。人事变化不证明注资、控制权变更或经营修复。"
    },
    {
      "code": "603272",
      "announcement_id": "1225679624",
      "pages": [
        1,
        2
      ],
      "answer": "联翔通知12月7日14时审议对外担保额度调整；对应已核额度分类调整事项，仍待股东会结果。",
      "boundary": "通知、董事会决议和专项公告是同一事项配套，不累计为多次新增担保或独立验证；未来审议安排不证明签署合同、实际担保余额增加或风险解除。"
    },
    {
      "code": "603729",
      "announcement_id": "1225679216",
      "pages": [
        1,
        2
      ],
      "answer": "龙韵计划11月27日11—12时召开三季度业绩说明会，提问预征集至11月26日16时；本文件提供交流安排。",
      "boundary": "三季报已于10月21日披露，说明会预告不是新增业绩结果或已答复投资者问题；落款19日与目录20日分别保留。后续答复需另查正式记录，不从参会人员或会议安排推断重组、盈利修复或行情因果。"
    }
  ],
  "limits": [
    "通知和会议资料不作为已经表决、交割、投保或业绩改善的结果",
