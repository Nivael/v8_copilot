  "document_pages": 26,
  "text_pages": 20,
  "critical_visual_pages": 19,
  "scanned_pages": 6,
  "findings": [
    {
      "code": "002323",
      "announcement_id": "1225679022",
      "pages": [
        1,
        3
      ],
      "answer": "雅博披露王东挺职工董事辞职于11月19日送达生效，当日职工代表大会选举王立冠，任期从表决通过日起算。",
      "boundary": "这是公司披露已完成的职工代表选举，不是等待股东会的独立董事提名。前任仍在公司任职；简历任职资格和无关联等为公司披露，未作独立人事核验，不推控制权、增持或经营修复。"
    },
    {
      "code": "600525",
      "announcement_id": "1225679959",
      "pages": [
        1,
        2
      ],
      "answer": "长园杨欢于11月18日辞去董秘并不再在公司及子公司任职；董事长由杨在空缺期间代行，正式选聘尚待完成。",
      "boundary": "正文证券简称为长园集团，历史固定样本不代表当日仍ST。代行不是已聘任新董秘；公司称不影响日常经营属于自述，不能据离职推断未披露风险或据正常措辞认风险解除。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679993",
      "pages": [
        1,
        3
      ],
      "answer": "高科11月19日董事会聘梁永振为董秘，任期从董事会通过日起；唐庆辞董秘后继续任副董事长等职务。",
      "boundary": "公司称已完成交易所备案，未独立取得备案凭据；本项可推进为公司披露已聘任，不混同独立董事仍待股东会选举。旧任并非离开公司，聘任不证明财务或内控问题已修复。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679990",
      "pages": [
        1
      ],
      "answer": "高科11月19日董事会聘童方宁为证券事务代表，协助董秘；潘睿莹因工作调整辞去该职。",
      "boundary": "这是证券事务代表聘任，与董秘聘任及独立董事提名为不同岗位，不把三个岗位合成三个经营利好，也不从履历推断注资或重组。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679989",
      "pages": [
        1
      ],
      "answer": "高科提名唐勇为独立董事候选人，当选后拟任审计委员会主任；仍待股东会审议。",
      "boundary": "公告说明前独董辞职后独董比例、审计委员会构成及会计专业召集人存在不足，这是补选背景。候选人承诺参加培训不等于已取得证明，提名与资格审查不证明完成补选或审计意见已消除。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679988",
      "pages": [
        1,
        2
      ],
      "answer": "高科董事会通过通知时限豁免、独董候选人提名及董秘/证券事务代表聘任；仅独董提名明确继续提交股东会。",
      "boundary": "同日董事会与专项公告是相同事项的配套，不重复计为多次聘任；全体议案通过不等于独董已获股东会选举，未由表决票数推断经营成效。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679986",
      "pages": [
        1
      ],
      "answer": "高科提名委员会11月19日出具唐勇任职资格审查意见，并重述其将参加培训取得证明的承诺。",
      "boundary": "公司内部审查意见不是独立第三方资格认证、交易所最终审核或股东会当选结果；与候选人/提名人声明共同组成同一补选依据。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679985",
      "pages": [
        1,
        2
      ],
      "answer": "高科11月30日股东会增加独董选举临时提案，20.03%股东珠海长世芯于19日提出，原登记日11月23日不变。",
      "boundary": "会后结果尚未发生；议程同时保留聘任会计师事务所议案，不把议程列示当已经续聘、完成审计或修复旧意见。股东提出提案不表示新持股或增资。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679995",
      "pages": [
        1,
        2,
        3
      ],
      "answer": "高科唐勇候选人声明属于独立董事补选配套，承诺任职资格与独立性，并承诺将参加培训取得证明。",
      "boundary": "三页为扫描件，无可提取文字，已逐页图像核看。声明末页手写日期读为11月12日，与20日目录公开、19日董事会正式提名分别保留，不倒填为12日市场已知；自我声明不等于当选、实际履职或第三方核验。"
    },
    {
      "code": "600730",
      "announcement_id": "1225679984",
      "pages": [
        1,
        2,
        3
      ],
      "answer": "高科董事会作为提名人出具唐勇声明，列其独立性、任职要求及培训承诺，是同一候选人的配套材料。",
      "boundary": "三页扫描件已逐页图像核看，无可提取文字；末页手写日期读为11月12日，不能据此认定当日已经公开或正式获选。提名人声明不增加独立验证，也不替代后续股东会结果。"
    }
  ],
  "limits": [
    "扫描声明签名及日期为人工图像读数，未用签名认证法律真实性",
    "人员聘任、提名、审议与实际治理改善不同阶段",
    "单日41附件核完不证明完整期间所有公告无遗漏，空返回限制保持",
    "文件数量不增加独立案例验证"
  ]
}
