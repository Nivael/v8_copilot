    "ResearchObject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stock",
            "stock_event",
            "episode_type",
            "cluster",
            "lens_cluster",
            "lens",
            "cohort",
            "universe",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
