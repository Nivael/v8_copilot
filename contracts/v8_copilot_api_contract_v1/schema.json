          "$ref": "#/$defs/QuestionInterpretation"
        },
        "route": {
          "$ref": "#/$defs/RouteDecision"
        },
        "answer_card": {
          "anyOf": [
            {
              "$ref": "../v8_answer_contract_v0/schema.json"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-contract-ref": "../v8_answer_contract_v0/schema.json"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/VerifiedClaim"
          },
          "maxItems": 100,
          "title": "Claims",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/GapDescriptor"
          },
          "maxItems": 50,
          "title": "Gaps",
          "type": "array"
        },
        "sedimentation_candidates": {
          "items": {
            "$ref": "#/$defs/SedimentationCandidate"
          },
          "maxItems": 50,
          "title": "Sedimentation Candidates",
          "type": "array"
        },
        "question_cards": {
          "items": {
            "$ref": "#/$defs/QuestionCard"
          },
          "maxItems": 20,
          "title": "Question Cards",
          "type": "array"
        },
        "data_debt_candidates": {
          "items": {
            "$ref": "#/$defs/DataDebtCandidate"
          },
          "maxItems": 20,
          "title": "Data Debt Candidates",
          "type": "array"
        },
        "navigation_refs": {
          "items": {
            "$ref": "#/$defs/NavigationRef"
          },
          "maxItems": 200,
          "title": "Navigation Refs",
          "type": "array"
        },
        "query_template_id": {
          "anyOf": [
            {
              "pattern": "^QT-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Template Id"
        },
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "degraded_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Degraded Reasons",
          "type": "array"
        },
        "llm_used": {
          "default": false,
          "title": "Llm Used",
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "interpretation",
        "route"
      ],
      "title": "ResearchResponseV1",
      "type": "object"
    },
    "ResearchStreamEventV1": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_copilot_api_contract_v1",
          "default": "v8_copilot_api_contract_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "event": {
          "enum": [
            "accepted",
            "interpreted",
            "routed",
            "answer_card",
            "claim_block",
            "degraded",
            "completed",
            "error"
          ],
          "title": "Event",
          "type": "string"
        },
        "emitted_at": {
          "format": "date-time",
          "title": "Emitted At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "sequence",
        "event"
      ],
      "title": "ResearchStreamEventV1",
      "type": "object"
    },
    "RouteDecision": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_copilot_api_contract_v0",
          "default": "v8_copilot_api_contract_v0",
          "title": "Contract Version",
          "type": "string"
        },
        "route": {
          "enum": [
            "answer_query",
            "answer_evidence",
            "answer_checklist",
            "answer_methodology",
            "data_debt",
            "lens_gap",
            "needs_review",
            "clarify",
            "refuse_or_rewrite"
          ],
          "title": "Route",
          "type": "string"
        },
        "status": {
          "enum": [
            "answerable",
            "needs_data",
            "needs_review",
            "clarify",
            "boundary"
          ],
          "title": "Status",
          "type": "string"
        },
        "view": {
          "enum": [
            "query",
            "evidence",
            "checklist",
            "methodology",
            "data_debt",
            "lens_gap",
            "clarify",
            "boundary"
          ],
          "title": "View",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "matched_rules": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Matched Rules",
          "type": "array"
        },
        "data_debt_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Data Debt Refs",
          "type": "array"
        },
        "question_card_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Question Card Refs",
          "type": "array"
        },
        "required_lens_behavior": {
          "enum": [
            "lens_invocation_required",
            "lens_invocations_or_gap",
            "lens_gap_required",
            "not_applicable"
          ],
          "title": "Required Lens Behavior",
          "type": "string"
        }
      },
      "required": [
        "route",
        "status",
        "view",
        "reason",
        "required_lens_behavior"
      ],
      "title": "RouteDecision",
      "type": "object"
    },
    "SedimentationCandidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "question_card",
            "data_debt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
