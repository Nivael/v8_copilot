    "VerifiedClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "fact",
            "inference",
            "caveat",
            "question",
            "data_gap"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "backing": {
          "$ref": "#/$defs/ClaimBacking"
