        "object": {
          "$ref": "#/$defs/QuestionObject"
        },
        "needs_data": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Needs Data",
          "type": "array"
        },
        "status": {
          "enum": [
            "answerable",
            "needs_data",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "view": {
          "enum": [
            "evidence",
            "query",
            "checklist",
            "methodology",
            "data_debt"
          ],
          "title": "View",
          "type": "string"
        },
        "source": {
          "enum": [
            "user",
            "human_review",
            "slice",
            "system_gap"
          ],
          "title": "Source",
          "type": "string"
        },
        "debt_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Debt Ref"
        },
        "created_from": {
          "items": {
            "$ref": "#/$defs/QuestionOrigin"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Created From",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "object",
        "status",
        "view",
        "source",
        "created_from"
      ],
      "title": "QuestionCard",
      "type": "object"
    },
    "QuestionInterpretation": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_copilot_api_contract_v0",
          "default": "v8_copilot_api_contract_v0",
          "title": "Contract Version",
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/ResearchObject"
        },
        "intent": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
