  "anyOf": [
    {
      "$ref": "#/$defs/ResearchResponseV1"
    },
    {
      "$ref": "#/$defs/ResearchStreamEventV1"
    },
    {
      "$ref": "#/$defs/NavigationRef"
    },
    {
      "$ref": "#/$defs/QuestionCard"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v8_copilot_api_contract_v1",
  "title": "ST Research Copilot API Contract v1",
  "x-contract-version": "v8_copilot_api_contract_v1"
