        "label": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "request_context",
            "answer_card",
            "answer_row",
            "lens_invocation",
            "provenance",
            "data_debt"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "href": {
          "pattern": "^/",
          "title": "Href",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ResearchContextPatch"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "source_kind",
        "source_ref",
        "href",
        "context"
      ],
      "title": "NavigationRef",
      "type": "object"
    },
    "QuestionCard": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_question_card_contract_v0",
          "default": "v8_question_card_contract_v0",
          "title": "Contract Version",
          "type": "string"
        },
        "id": {
          "pattern": "^QC-(?:[0-9]{8}-[0-9]{3}|CAND-[a-f0-9]{12})$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
