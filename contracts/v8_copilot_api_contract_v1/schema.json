    "ResearchResponseV1": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_copilot_api_contract_v1",
          "default": "v8_copilot_api_contract_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
