          "type": "string"
        },
        "ref": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "QuestionOrigin",
      "type": "object"
