        "dimensions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Dimensions",
          "type": "array"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Ambiguities",
          "type": "array"
        },
        "candidate_topics": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Candidate Topics",
          "type": "array"
