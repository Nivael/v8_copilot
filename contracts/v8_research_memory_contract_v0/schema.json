{
  "$defs": {
    "DataDebtCard": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "v8_research_memory_contract_v0",
          "title": "Contract Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "accepted",
            "ignored",
            "merged",
            "blocked",
            "closed"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "provenance_refs": {
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Provenance Refs",
          "type": "array"
        },
        "memory_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "canonical_key": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Canonical Key",
          "type": "string"
        },
        "dedupe_key": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dedupe Key",
          "type": "string"
        },
        "not_evidence": {
          "const": true,
          "title": "Not Evidence",
          "type": "boolean"
        },
        "record_type": {
          "const": "data_debt",
          "title": "Record Type",
          "type": "string"
        },
        "gap_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Gap Id",
          "type": "string"
        },
        "gap_summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Gap Summary",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ObjectScope"
        },
        "time_scope": {
          "$ref": "#/$defs/TimeScope"
        },
        "missing_assets": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Missing Assets",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Missing Fields",
          "type": "array"
        },
        "blocked_question_card_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Blocked Question Card Refs",
          "type": "array"
        },
        "owner": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "external_debt_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Debt Ref"
        },
        "debt_ref_status": {
          "enum": [
            "assigned",
            "needs_assignment"
          ],
          "title": "Debt Ref Status",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "status",
        "created_at",
        "updated_at",
        "source_refs",
        "provenance_refs",
        "memory_id",
        "canonical_key",
        "dedupe_key",
        "not_evidence",
        "record_type",
        "gap_id",
        "gap_summary",
        "scope",
        "time_scope",
        "missing_assets",
        "missing_fields",
        "blocked_question_card_refs",
        "owner",
        "debt_ref_status"
      ],
      "title": "DataDebtCard",
      "type": "object"
    },
    "ExecutorRef": {
      "additionalProperties": false,
      "properties": {
        "registry_contract_version": {
          "pattern": "^v8_query_template_contract_v[0-9]+$",
