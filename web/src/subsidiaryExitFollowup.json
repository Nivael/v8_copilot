  "reviews": [
    {
      "key": "different_subsidiaries",
      "symbol": "000826",
      "source_ids": [
        "1225479212",
        "1225557393"
      ],
      "title": "参股公司宣告破产，与全资子公司重整受理不是同一主体",
      "fact": "8月19日公告披露参股22.7673%的桑顿新能源终止重整并被宣告破产；9月11日公告披露全资子公司合加新能源重整申请获受理，仍有成功不确定性。都不能替代上市公司自身的程序状态。",
      "meaning": "桑顿不在合并报表内，但公告时27166.54万元剩余担保尚未解除；6365.49万元占用余额为2025年末对湖南桑德的口径，不补成8月最新余额，也不与担保相加当损失。合加披露2025年末净资产20648.85万元为正，仍不能据此推翻后来到期债务清偿困难；不将旧年末净资产当9月即时余额。",
      "limits": "公司引述裁定，不等本轮取得法院独立原文；近日查询/内部报告不补成精确裁定或收到日。母公司当时预重整与子公司受理分别核，不能从9月公告认证11月19日母公司仍未进入其他阶段。",
      "next": "继续核担保实际代偿/追偿、占款最新余额、子公司计划与执行及财务处理，不由破产或受理标题直接算损失。"
    },
    {
      "key": "one_exit_multiple_notices",
      "symbol": "000016",
      "source_ids": [
        "1225522090",
        "1225537108",
        "1225540247",
        "1225543743"
      ],
      "title": "说明会与三次倒计时回指同一主动退出安排",
      "fact": "8月28日公告计划8月31日举行说明会；9月1、2、3日三件依次提示停牌尚余3、2、1个交易日，均对应9月4日起停牌安排，文件当时仍待9月14日股东会。",
      "meaning": "投票股权登记日与现金选择权登记日不同：文件列A股投票登记9月3日、B股9月8日；现金选择权登记拟为A股9月22日、B股9月28日。登记、申报、取得现金和摘牌是不同节点；三份倒计时不增加三次退出案例或三次独立验证。",
      "limits": "说明会安排不认证实际召开；现金选择权取决于股东会通过、权利限制等条件，不能当实际账户已获偿。这四份早期文件不替代后来正式终止上市、摘牌及现金执行原件，原已核退出结果保留。",
      "next": "若核具体账户结果，再取实际申报、资金和股份登记证明；不把安排日期直接当执行完成。"
    },
    {
      "key": "unpaid_investment_termination",
      "symbol": "002175",
      "source_ids": [
        "1225650013"
      ],
      "title": "终止500万元拟投资，不等收回500万元",
      "fact": "10月31日目录披露、PDF落款10月30日。东智决定终止拟出资500万元、持股10%的对外投资；披露时未签投资协议、未支付投资款、标的未设立。",
      "meaning": "拟出资50万元注册资本加450万元资本公积合计500万元，没有因此形成已付款或退款。原件称事项在董事会权限内无需股东会，不应套用其他收购的股东会待审门槛。",
      "limits": "本件不证明其他投资或关联交易的状态，也不据终止认定新增损失、回款或经营修复。",
      "next": "原拟议事项可记录为终止，不新增实际收回资金；同窗行情与其因果另核。"
